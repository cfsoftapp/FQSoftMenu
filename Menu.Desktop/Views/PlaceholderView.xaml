<UserControl x:Class="Menu.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="32"
            Padding="28"
            Background="White"
            BorderBrush="#E1E4EC"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel Width="520"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       Text="{Binding Title}" />

            <TextBlock Margin="0,10,0,0"
                       FontSize="15"
                       Foreground="#FF4081"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />

            <Border Margin="0,24,0,0"
                    Padding="14"
                    Background="#EEF6FF"
                    BorderBrush="#90CAF9"
                    BorderThickness="1"
                    CornerRadius="4">
                <TextBlock Foreground="#1565C0"
                           Text="Vista pendiente de migrar a WPF. La navegacion ya esta preparada." />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
