<UserControl x:Class="Menu.Desktop.Views.EmpleadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconActionStyle" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#594AE2" />
            <Setter Property="BorderBrush" Value="#594AE2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#594AE2" />
            <Setter Property="Foreground" Value="#594AE2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="CenterTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LeftTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Border Margin="32"
            Padding="20"
            Background="White"
            BorderBrush="#E1E4EC"
            BorderThickness="1"
            CornerRadius="6">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="0,0,0,14"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Width="138"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Path Width="15"
                              Height="15"
                              Margin="0,0,8,0"
                              Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11,11 L15,15"
                              Stroke="White"
                              StrokeThickness="2"
                              Stretch="Uniform" />
                        <TextBlock Text="ACTUALIZAR" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right"
                        Width="156"
                        Margin="0,0,10,0"
                        Command="{Binding NewCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   FontSize="18"
                                   Text="+" />
                        <TextBlock Text="NUEVO COMENSAL" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right"
                        Width="132"
                        Margin="0,0,10,0"
                        Command="{Binding ImportCsvCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,8,0"
                              Data="M8,1 L8,10 M4,6 L8,10 L12,6 M3,13 L13,13"
                              Stroke="#594AE2"
                              StrokeThickness="1.8"
                              Stretch="Uniform" />
                        <TextBlock Text="CARGA CSV" />
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right"
                        Width="138"
                        Margin="0,0,10,0"
                        Command="{Binding ExportFormatCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,8,0"
                              Data="M4,1 L11,1 L13,3 L13,15 L4,15 Z M11,1 L11,4 L13,4 M6,7 L11,7 M6,10 L11,10 M6,13 L9,13"
                              Stroke="#594AE2"
                              StrokeThickness="1.4"
                              Stretch="Uniform" />
                        <TextBlock Text="FORMATO" />
                    </StackPanel>
                </Button>

                <Border Width="430"
                        Height="38"
                        Background="White"
                        BorderBrush="#B9C0CC"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Width="16"
                              Height="16"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11,11 L15,15"
                              Stroke="#777777"
                              StrokeThickness="2"
                              Stretch="Uniform" />

                        <TextBox Grid.Column="1"
                                 Padding="0,8,10,6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom"
                        Margin="0,12,0,0">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#555555"
                               Text="{Binding Estado}" />

                    <StackPanel DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   Text="Filas:" />
                        <ComboBox Width="64"
                                  Height="30"
                                  Margin="0,0,18,0"
                                  ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding PageSize, Mode=TwoWay}" />
                        <TextBlock Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   Text="{Binding PageInfo}" />
                        <TextBlock Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="#555555"
                                   Text="{Binding CurrentPageText}" />
                        <Button Width="34"
                                Height="30"
                                Margin="0,0,8,0"
                                Command="{Binding PreviousPageCommand}"
                                Content="&lt;"
                                FontSize="18" />
                        <Button Width="34"
                                Height="30"
                                Command="{Binding NextPageCommand}"
                                Content="&gt;"
                                FontSize="18" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <Border DockPanel.Dock="Top"
                    BorderBrush="#E1E4EC"
                    BorderThickness="1"
                    CornerRadius="6">
                <DataGrid AutoGenerateColumns="False"
                          AlternatingRowBackground="#FAFBFF"
                          Background="White"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          ColumnHeaderHeight="38"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#E1E4EC"
                          IsReadOnly="True"
                          ItemsSource="{Binding Empleados}"
                          RowHeight="42"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="BorderBrush" Value="#E1E4EC" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#222222" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="12,0" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="#222222" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F2F0FF" />
                                    <Setter Property="Foreground" Value="#222222" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Width="105"
                                            Binding="{Binding Dni}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}"
                                            Header="DNI" />

                        <DataGridTextColumn Width="1.6*"
                                            Binding="{Binding NombreCompleto}"
                                            ElementStyle="{StaticResource LeftTextCellStyle}"
                                            Header="Nombres y Apellidos" />

                        <DataGridTextColumn Width="1.35*"
                                            Binding="{Binding EmpresaCliente}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}"
                                            Header="Empresa cliente" />

                        <DataGridTextColumn Width="1.1*"
                                            Binding="{Binding Sucursal}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}"
                                            Header="Sucursal" />

                        <DataGridTemplateColumn Width="135"
                                                Header="Tipo de comensal">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border MinWidth="58"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderBrush="#2196F3"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock FontSize="12"
                                                   Foreground="#007BFF"
                                                   Text="{Binding Categoria}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="110"
                                                Header="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border MinWidth="62"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding EstadoBrush}"
                                            CornerRadius="10">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="{Binding Estado}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="85"
                                                Header="Activo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border MinWidth="36"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            BorderBrush="{Binding ActivoBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <TextBlock FontSize="12"
                                                   Foreground="{Binding ActivoBrush}"
                                                   Text="{Binding Activo}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="115"
                                            Binding="{Binding FechaCreacion}"
                                            ElementStyle="{StaticResource CenterTextCellStyle}"
                                            Header="Fecha creación" />

                        <DataGridTemplateColumn Width="115"
                                                Header="Acciones">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Editar comensal">
                                            <Path Data="M3,13 L6,12 L13,5 L11,3 L4,10 Z M10.5,3.5 L12.5,1.5 L14.5,3.5 L12.5,5.5 Z"
                                                  Fill="#594AE2"
                                                  Style="{StaticResource IconActionStyle}" />
                                        </Button>

                                        <Button Command="{Binding DataContext.ToggleEstadoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Activar o suspender beneficio">
                                            <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M6,5 L11,8 L6,11 Z"
                                                  Fill="#00C853"
                                                  Style="{StaticResource IconActionStyle}" />
                                        </Button>

                                        <Button Command="{Binding DataContext.ToggleActivoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Activar o desactivar comensal">
                                            <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M4,4 L12,12 M12,4 L4,12"
                                                  Stroke="#FF3D3D"
                                                  StrokeThickness="1.8"
                                                  Style="{StaticResource IconActionStyle}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
