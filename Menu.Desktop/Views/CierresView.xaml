<UserControl x:Class="Menu.Desktop.Views.CierresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CenteredHistoryText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F1FF" />
                    <Setter Property="BorderBrush" Value="#D8D3FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14" Background="#F6F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="12,8"
                Background="{Binding EstadoBackground}"
                BorderBrush="{Binding EstadoBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock Foreground="{Binding EstadoForeground}" Text="{Binding Estado}" />
        </Border>

        <Grid Grid.Row="1" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,10,0" Padding="14" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#F0EEFF" CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#594AE2" FontSize="20" Text="▤" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock FontSize="22" Text="{Binding TotalCierres}" />
                        <TextBlock Foreground="#FF4081" Text="Total cierres" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="0,0,10,0" Padding="14" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#EAF4FF" CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2196F3" FontSize="20" Text="➤" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock FontSize="22" Text="{Binding PendientesConfirmar}" />
                        <TextBlock Foreground="#FF4081" Text="Pendientes de confirmar" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="0,0,10,0" Padding="14" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#E8F5E9" CornerRadius="19">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#00A86B" FontSize="20" Text="✓" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock FontSize="22" Text="{Binding MontoConfirmadoText}" />
                        <TextBlock Foreground="#FF4081" Text="Monto confirmado" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button Grid.Column="3"
                    Width="160"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="#594AE2"
                    BorderBrush="#594AE2"
                    Command="{Binding NuevoCierreCommand}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Visibility="{Binding CanManage, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="+  NUEVO CIERRE" />
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,14,16,12">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Historial de facturacion" />
                        <TextBlock Margin="0,3,0,0" Foreground="#FF4081" Text="Borradores y liquidaciones confirmadas al proveedor." />
                    </StackPanel>
                    <Button Width="120"
                            Height="34"
                            HorizontalAlignment="Right"
                            BorderBrush="#594AE2"
                            Foreground="#594AE2"
                            Command="{Binding ActualizarCommand}"
                            Content="↻  ACTUALIZAR" />
                </Grid>

                <DataGrid Grid.Row="1"
                          Margin="16,0,16,16"
                          AlternatingRowBackground="#FAFBFF"
                          AutoGenerateColumns="False"
                          BorderBrush="#E1E4EC"
                          BorderThickness="1"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          ColumnHeaderHeight="40"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E1E4EC"
                          IsReadOnly="True"
                          ItemsSource="{Binding Cierres}"
                          RowHeaderWidth="0"
                          RowHeight="48"
                          SelectionMode="Single"
                          VerticalGridLinesBrush="Transparent">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FAFAFC" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.4*" Binding="{Binding Periodo}" Header="Periodo">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CenteredHistoryText}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="0.8*" MinWidth="110" Header="Estado">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border MinWidth="72"
                                            Height="24"
                                            Padding="10,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{Binding EstadoBackground}"
                                            CornerRadius="12">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Estado}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="0.55*" MinWidth="75" Binding="{Binding TotalItems}" ElementStyle="{StaticResource CenteredHistoryText}" Header="Items" />
                        <DataGridTextColumn Width="0.8*" MinWidth="105" Binding="{Binding TotalText}" ElementStyle="{StaticResource CenteredHistoryText}" Header="Monto" />
                        <DataGridTextColumn Width="1.15*" MinWidth="175" Binding="{Binding FechaRegistro}" ElementStyle="{StaticResource CenteredHistoryText}" Header="Generado" />
                        <DataGridTemplateColumn Width="1.05*" MinWidth="170" Header="Acciones">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Button Click="Ver_Click"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Ver detalle">
                                            <Path Data="M1,8 C4,3 8,1 12,1 C16,1 20,3 23,8 C20,13 16,15 12,15 C8,15 4,13 1,8 M12,4 A4,4 0 1 0 12,12 A4,4 0 1 0 12,4"
                                                  Fill="Transparent"
                                                  Stroke="#594AE2"
                                                  StrokeThickness="1.8"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Click="Editar_Click"
                                                CommandParameter="{Binding}"
                                                ToolTip="Editar borrador">
                                            <Path Data="M3,16 L4,12 L14,2 L18,6 L8,16 Z M12,4 L16,8"
                                                  Fill="Transparent"
                                                  Stroke="#FF9800"
                                                  StrokeThickness="1.8"
                                                  Stretch="Uniform" />
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding EsBorrador}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Click="Eliminar_Click"
                                                CommandParameter="{Binding}"
                                                ToolTip="Eliminar borrador">
                                            <Path Data="M4,5 L16,5 M7,5 L7,3 L13,3 L13,5 M6,7 L7,17 L15,17 L16,7 M9,8 L9,15 M13,8 L13,15"
                                                  Fill="Transparent"
                                                  Stroke="#F44336"
                                                  StrokeThickness="1.8"
                                                  Stretch="Uniform" />
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding EsBorrador}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Click="Excel_Click"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                ToolTip="Descargar Excel">
                                            <Path Data="M10,2 L10,13 M6,9 L10,13 L14,9 M3,15 L3,18 L17,18 L17,15"
                                                  Fill="Transparent"
                                                  Stroke="#00A86B"
                                                  StrokeThickness="1.8"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
