<UserControl x:Class="Menu.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="32"
            Padding="28"
            Background="White"
            BorderBrush="#E1E4EC"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right"
                        Width="150"
                        Height="36"
                        Background="#594AE2"
                        BorderBrush="#594AE2"
                        Command="{Binding RefreshCommand}"
                        Foreground="White"
                        FontWeight="SemiBold">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Path Width="15"
                              Height="15"
                              Margin="0,0,8,0"
                              Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 M11,11 L15,15"
                              Stroke="White"
                              StrokeThickness="2"
                              Stretch="Uniform" />
                        <TextBlock Text="CONSULTAR" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#333333"
                               Text="Fecha" />

                    <DatePicker Width="150"
                                Margin="12,0,0,0"
                                SelectedDate="{Binding Fecha}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="230"
                                Height="112"
                                Margin="0,0,14,14"
                                Padding="18"
                                Background="#FAFBFF"
                                BorderBrush="#E1E4EC"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           Foreground="{Binding Accent}"
                                           Text="{Binding Title}" />

                                <TextBlock Margin="0,14,0,0"
                                           FontSize="30"
                                           Foreground="#333333"
                                           Text="{Binding Value}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,8,0,18" />

            <TextBlock FontSize="15"
                       Foreground="#555555"
                       Text="{Binding Estado}" />
        </StackPanel>
    </Border>
</UserControl>
