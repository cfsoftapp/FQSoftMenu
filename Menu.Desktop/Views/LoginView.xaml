<UserControl x:Class="Menu.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Menu.Desktop.Services"
             Loaded="LoginView_Loaded">
    <Grid Margin="32"
          Background="#F6F7FB">
        <Border Width="520"
                Padding="22,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#E1E4EC"
                BorderThickness="1"
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="3"
                                  Color="#333333" />
            </Border.Effect>

            <StackPanel>
                <Path Width="34"
                      Height="34"
                      HorizontalAlignment="Center"
                      Data="M4,2 L15,13 M15,2 L4,13 M15,2 A4,4 0 1 1 21,8 A4,4 0 1 1 15,2 M4,2 L2,4 L13,15 L15,13 Z"
                      Fill="#594AE2"
                      Stretch="Uniform" />

                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           Foreground="#333333"
                           Text="FQSoft Menu" />

                <TextBlock Margin="0,4,0,24"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           Foreground="#FF4081"
                           Text="Inicia sesion para registrar consumos del comedor." />

                <Border Margin="0,0,0,16"
                        Padding="14"
                        BorderBrush="#FF9800"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasMensajeError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Path Width="22"
                              Height="22"
                              Margin="0,0,12,0"
                              Data="M10,1 L19,18 L1,18 Z M10,6 L10,11 M10,14 L10,15"
                              Stroke="#FF9800"
                              StrokeThickness="1.8"
                              Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#EF6C00"
                                   FontSize="14"
                                   Text="{Binding MensajeError}" />
                    </DockPanel>
                </Border>

                <TextBlock Margin="16,0,0,6"
                           Foreground="#333333"
                           Text="Usuario*" />

                <Border Height="56"
                        BorderBrush="#BFC3CC"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M8,8 A4,4 0 1 0 8,0 A4,4 0 1 0 8,8 M1,16 C1,11 15,11 15,16 Z"
                              Fill="#777777"
                              Stretch="Uniform" />

                        <TextBox x:Name="UsuarioTextBox"
                                 Grid.Column="1"
                                 Padding="4,16,10,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 KeyDown="LoginInput_KeyDown"
                                 Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <TextBlock Margin="16,14,0,6"
                           Foreground="#333333"
                           Text="Clave*" />

                <Border Height="56"
                        BorderBrush="#BFC3CC"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Path Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M4,7 L4,5 A4,4 0 0 1 12,5 L12,7 M3,7 L13,7 L13,16 L3,16 Z M8,10 L8,13"
                              Fill="#777777"
                              Stretch="Uniform" />

                        <PasswordBox x:Name="ClavePasswordBox"
                                     Grid.Column="1"
                                     Padding="4,16,10,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="15"
                                     KeyDown="LoginInput_KeyDown"
                                     services:PasswordBoxBinding.BindPassword="True"
                                     services:PasswordBoxBinding.BoundPassword="{Binding Clave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <Button Margin="0,18,0,0"
                        Height="42"
                        Background="#594AE2"
                        BorderBrush="#594AE2"
                        Command="{Binding LoginCommand}"
                        Foreground="White"
                        FontWeight="SemiBold">
                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Path Width="16"
                              Height="16"
                              Margin="0,0,8,0"
                              Data="M2,2 L8,2 L8,4 L4,4 L4,12 L8,12 L8,14 L2,14 Z M9,5 L13,8 L9,11 L9,9 L6,9 L6,7 L9,7 Z"
                              Fill="White"
                              Stretch="Uniform" />
                        <TextBlock Text="INGRESAR" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
