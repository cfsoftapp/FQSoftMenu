<Window x:Class="Menu.Desktop.Views.CierreProveedorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cierre de facturacion"
        Width="1050"
        Height="820"
        MinWidth="900"
        MinHeight="680"
        Background="#F6F7FB"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style x:Key="ReviewGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFF" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E1E4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E4EC" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F7F8FC" />
                        <Setter Property="BorderBrush" Value="#E1E4EC" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CenteredReviewText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ExpandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8DDEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#594AE2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal">
                <Border Width="30" Height="30" Background="#F0EEFF" CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#594AE2" FontSize="18" Text="▤" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Text="{Binding DialogTitle}" />
            </StackPanel>
            <Button Width="32" Height="30" HorizontalAlignment="Right" Click="Cerrar_Click" Content="×" FontSize="18" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,7,0">
                <TextBlock Margin="0,0,0,4" Text="Desde" />
                <DatePicker Height="38" SelectedDate="{Binding FechaDesde}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="7,0">
                <TextBlock Margin="0,0,0,4" Text="Hasta" />
                <DatePicker Height="38" SelectedDate="{Binding FechaHasta}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Height="38"
                    Margin="7,20,0,0"
                    BorderBrush="#594AE2"
                    Foreground="#594AE2"
                    Click="Calcular_Click"
                    Content="CALCULAR"
                    IsEnabled="{Binding CanCalculate}" />
        </Grid>

        <UniformGrid Grid.Row="2" Margin="0,0,0,12" Columns="4">
            <Border Margin="0,0,8,0" Padding="11" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Foreground="#FF4081" Text="Activos incluidos" />
                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalActivosText}" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777777">
                        <Run Text="{Binding TotalMenusActivos}" /><Run Text=" menu(s), " /><Run Text="{Binding TotalAdicionalesEmpresa}" /><Run Text=" adicional(es)" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="11" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Foreground="#FF4081" Text="Planilla incluida" />
                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalPlanillaText}" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777777">
                        <Run Text="{Binding TotalMenusPlanilla}" /><Run Text=" menu(s)" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="11" Background="White" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Foreground="#FF4081" Text="Revision" />
                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalRevisionText}" />
                    <TextBlock Margin="0,3,0,0" Foreground="#777777">
                        <Run Text="{Binding TotalExcepciones}" /><Run Text=" excepcion(es)" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Padding="11" Background="#F7FFF8" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="5">
                <StackPanel><TextBlock Foreground="#FF4081" Text="Total a facturar" /><TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding TotalFacturarText}" /></StackPanel>
            </Border>
        </UniformGrid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="#555555" Text="Buscar comensal" />
                        <TextBox Height="38" Padding="12,6" VerticalContentAlignment="Center"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Empresa cliente (activos y autorizados)" />
                        <TextBlock Margin="0,3,0,10" Foreground="#FF4081"
                                   Text="Se incluyen automaticamente. Revisa menus, extras y productos autorizados." />
                        <ItemsControl ItemsSource="{Binding GruposActivos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Height="38" Background="#FAFBFF">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="75" /><ColumnDefinition Width="115" /><ColumnDefinition Width="105" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding ToggleCommand}"
                                                        Content="{Binding ExpandIcon}"
                                                        Style="{StaticResource ExpandButtonStyle}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding NombreCompleto}" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CantidadItems}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TotalFacturarText}" />
                                                <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TotalRevisionText}" />
                                            </Grid>
                                            <DataGrid Margin="10,6,10,10"
                                                      Style="{StaticResource ReviewGridStyle}"
                                                      ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="75" Binding="{Binding Fecha}" ElementStyle="{StaticResource CenteredReviewText}" Header="Fecha" IsReadOnly="True" />
                                                    <DataGridTextColumn Width="*" Binding="{Binding Concepto}" ElementStyle="{StaticResource CenteredReviewText}" Header="Concepto" IsReadOnly="True" />
                                                    <DataGridTextColumn Width="90" Binding="{Binding ImporteText}" ElementStyle="{StaticResource CenteredReviewText}" Header="Importe" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Width="75" Header="Revision">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          IsChecked="{Binding Excluir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="180" Header="Motivo">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Margin="4,2"
                                                                         Padding="6,2"
                                                                         BorderBrush="#D8DDEA"
                                                                         IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Descuento planilla (suspendidos)" />
                        <TextBlock Margin="0,3,0,10" Foreground="#FF4081"
                                   Text="Lo incluido pasa a facturacion y se recupera mediante planilla." />
                        <ItemsControl ItemsSource="{Binding GruposPlanilla}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" BorderBrush="#E1E4EC" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Height="38" Background="#FAFBFF">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" /><ColumnDefinition Width="85" />
                                                    <ColumnDefinition Width="115" /><ColumnDefinition Width="105" />
                                                </Grid.ColumnDefinitions>
                                                <Button Command="{Binding ToggleCommand}"
                                                        Content="{Binding ExpandIcon}"
                                                        Style="{StaticResource ExpandButtonStyle}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding NombreCompleto}" />
                                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CantidadItems}" />
                                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding CantidadExcepciones}" />
                                                <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TotalFacturarText}" />
                                                <TextBlock Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TotalRevisionText}" />
                                            </Grid>
                                            <DataGrid Margin="10,6,10,10"
                                                      Style="{StaticResource ReviewGridStyle}"
                                                      ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="75" Binding="{Binding Fecha}" ElementStyle="{StaticResource CenteredReviewText}" Header="Fecha" IsReadOnly="True" />
                                                    <DataGridTextColumn Width="*" Binding="{Binding Concepto}" ElementStyle="{StaticResource CenteredReviewText}" Header="Concepto" IsReadOnly="True" />
                                                    <DataGridTextColumn Width="90" Binding="{Binding ImporteText}" ElementStyle="{StaticResource CenteredReviewText}" Header="Importe" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Width="80" Header="No enviar">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          IsChecked="{Binding Excluir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Width="180" Header="Motivo">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBox Margin="4,2"
                                                                         Padding="6,2"
                                                                         BorderBrush="#D8DDEA"
                                                                         IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                         Text="{Binding Motivo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="10" Background="#EEF6FF" BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="4">
                    <TextBlock Foreground="#1565C0" Text="{Binding Mensaje}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Notas" />
                <TextBox Height="48"
                         Padding="10,6"
                         IsEnabled="{Binding CanEdit}"
                         MaxLength="250"
                         Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,20,0,0" Orientation="Horizontal">
                <Button Width="90" Height="38" Click="Cerrar_Click" Content="CERRAR" />
                <Button Width="145" Height="38" Margin="8,0,0,0" BorderBrush="#594AE2" Foreground="#594AE2"
                        Click="Guardar_Click" Content="GUARDAR BORRADOR" IsEnabled="{Binding CanEdit}" />
                <Button Width="95"
                        Height="38"
                        Margin="8,0,0,0"
                        BorderBrush="#00A86B"
                        Foreground="#00A86B"
                        Click="Excel_Click"
                        Content="EXCEL"
                        IsEnabled="{Binding CanExport}" />
                <Button Width="120" Height="38" Margin="8,0,0,0" Background="#00C853" BorderBrush="#00C853"
                        Click="Confirmar_Click" Foreground="White" FontWeight="SemiBold" Content="CONFIRMAR" IsEnabled="{Binding CanConfirm}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
