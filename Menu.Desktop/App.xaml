<Application x:Class="Menu.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Menu.Desktop.Converters"
             xmlns:viewModels="clr-namespace:Menu.Desktop.ViewModels"
             xmlns:views="clr-namespace:Menu.Desktop.Views">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:EmpleadosViewModel}">
            <views:EmpleadosView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:RegistroDiarioViewModel}">
            <views:RegistroDiarioView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CuentasPorCobrarViewModel}">
            <views:CuentasPorCobrarView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ReportesViewModel}">
            <views:ReportesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:CierresViewModel}">
            <views:CierresView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:UsuariosViewModel}">
            <views:UsuariosView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:ConfiguracionViewModel}">
            <views:ConfiguracionView />
        </DataTemplate>
    </Application.Resources>
</Application>
