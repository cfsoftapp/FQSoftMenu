@page "/empleados"

@using Menu.Components.Shared
@using Menu.DTOs.Empleados
@using Menu.Enums
@using Menu.Models
@using Menu.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text

@inject EmpleadoService EmpleadoService
@inject TipoEmpleadoService TipoEmpleadoService
@inject EmpresaClienteService EmpresaClienteService
@inject SucursalService SucursalService
@inject AuthStateService AuthState
@inject ISnackbar Snackbar


<RequirePermission Permisos="new[] { Permisos.EmpleadosVer }">

<PageTitle>Comensales</PageTitle>

<MudStack Spacing="3">

    <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween" 
                  Class="mb-3">

            <div>
                <MudText Typo="Typo.h4">
                    Comensales
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Mantenimiento de comensales y estado del beneficio de menú.
                </MudText>
            </div>
        @if (AuthState.TienePermiso(Permisos.EmpleadosCrear))
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NuevoEmpleado">
                Nuevo comensal
            </MudButton>
        }
    </MudStack>

        <MudPaper Class="pa-3 mb-3 rounded-lg" Elevation="1">

            <MudStack Spacing="3">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Spacing="2">
                    <MudTextField @bind-Value="_search"
                                  Label="Buscar por DNI o nombre del comensal"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="max-width-search" />

                    @if (AuthState.TienePermiso(Permisos.EmpleadosCrear))
                    {
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       Href="/empleados/formato-carga.csv"
                                       Target="_blank">
                                Formato carga
                            </MudButton>
                        </MudStack>
                    }
                </MudStack>

                @if (AuthState.TienePermiso(Permisos.EmpleadosCrear))
                {
                    <MudPaper Class="pa-3 rounded-lg" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <div>
                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Carga masiva de comensales</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Usa el formato CSV. Primero se revisa; luego confirma para guardar los registros válidos.
                                    </MudText>
                                </div>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    @if (_filasCargaPendiente.Count > 0 && _resultadoCarga?.Pendientes > 0)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                                   Disabled="@_procesandoCarga"
                                                   OnClick="ConfirmarCargaMasiva">
                                            Confirmar carga
                                        </MudButton>
                                    }

                                    <InputFile OnChange="PrevisualizarCargaMasiva"
                                               accept=".csv,text/csv"
                                               disabled="@_procesandoCarga" />
                                </MudStack>
                            </MudStack>

                            @if (_resultadoCarga is not null)
                            {
                                <MudAlert Severity="@(_resultadoCarga.Observados > 0 ? Severity.Warning : Severity.Success)" Variant="Variant.Outlined">
                                    @if (_resultadoCarga.Importados > 0)
                                    {
                                        <span>Importados: @_resultadoCarga.Importados / @_resultadoCarga.TotalFilas.</span>
                                    }
                                    else
                                    {
                                        <span>Listos para importar: @_resultadoCarga.Pendientes / @_resultadoCarga.TotalFilas.</span>
                                    }
                                    Observados: @_resultadoCarga.Observados.
                                </MudAlert>

                                <MudTable Items="_resultadoCarga.Resultados"
                                          Dense="true"
                                          Hover="true"
                                          Breakpoint="Breakpoint.Sm">
                                    <HeaderContent>
                                        <MudTh>Fila</MudTh>
                                        <MudTh>DNI</MudTh>
                                        <MudTh>Comensal</MudTh>
                                        <MudTh>Estado</MudTh>
                                        <MudTh>Mensaje</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Fila">@context.NumeroFila</MudTd>
                                        <MudTd DataLabel="DNI">@context.Dni</MudTd>
                                        <MudTd DataLabel="Comensal">@context.Trabajador</MudTd>
                                        <MudTd DataLabel="Estado">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@(context.Importado ? Color.Success : Color.Warning)"
                                                     Variant="Variant.Outlined">
                                                @context.Estado
                                            </MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Mensaje">@context.Mensaje</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>

        </MudPaper>

    <MudPaper Class="pa-0 mb-4 rounded-lg overflow-hidden" Elevation="1">
        <MudTable Items="FilteredEmpleados"
                  Hover="true"
                  Dense="true"
                  Bordered="false"
                  Striped="true"
                  Breakpoint="Breakpoint.Sm"
                  Loading="_loading">

            <HeaderContent>
                <MudTh>DNI</MudTh>
                <MudTh>Nombres y Apellidos</MudTh>
                <MudTh>Empresa cliente</MudTh>
                <MudTh>Sucursal</MudTh>
                <MudTh>Tipo de comensal</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh>Activo</MudTh>
                <MudTh>Fecha creación</MudTh>
                <MudTh Style="text-align:right">Acciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="DNI">@context.Dni</MudTd>
                <MudTd DataLabel="Nombre">@context.NombreCompleto</MudTd>

                <MudTd DataLabel="Empresa cliente">@context.EmpresaClienteNombre</MudTd>

                <MudTd DataLabel="Sucursal">@context.SucursalNombre</MudTd>

                <MudTd DataLabel="Tipo de comensal">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="Color.Info"
                             Variant="Variant.Outlined">
                        @context.TipoEmpleadoNombre
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Estado">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.Estado == EstadoEmpleado.Activo ? Color.Success : Color.Warning)"
                             Variant="Variant.Filled">
                        @context.Estado
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Activo">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.Activo ? Color.Success : Color.Error)"
                             Variant="Variant.Outlined">
                        @(context.Activo ? "Sí" : "No")
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Fecha creación">
                    @context.FechaCreacion.ToString("dd/MM/yyyy")
                </MudTd>

                    <MudTd DataLabel="Acciones" Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       aria-label="Editar comensal"
                                       OnClick="@(() => EditarEmpleado(context))" />

                        <MudIconButton Icon="@(context.Estado == EstadoEmpleado.Activo ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)"
                                       Color="@(context.Estado == EstadoEmpleado.Activo ? Color.Warning : Color.Success)"
                                       Size="Size.Small"
                                       aria-label="@(context.Estado == EstadoEmpleado.Activo ? "Suspender beneficio" : "Activar beneficio")"
                                       OnClick="@(() => CambiarEstadoBeneficio(context.Id))" />

                        <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                       Color="@(context.Activo ? Color.Error : Color.Success)"
                                       Size="Size.Small"
                                       aria-label="@(context.Activo ? "Desactivar comensal" : "Activar comensal")"
                                       OnClick="@(() => CambiarActivo(context.Id))" />
                    </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary">
                    No se encontraron comensales.
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50 }" />
            </PagerContent>

        </MudTable>
    </MudPaper>

        @if (_showForm)
        {
            <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="1">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mb-3">

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Person"
                                 Color="Color.Primary" />

                        <div>
                            <MudText Typo="Typo.h6">
                                @(_editingId == 0 ? "Nuevo comensal" : "Editar comensal")
                            </MudText>

                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Completa los datos del comensal y su estado del beneficio de menú.
                            </MudText>
                        </div>
                    </MudStack>

                    @if (_editingId != 0)
                    {
                        <MudChip T="string"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small">
                            DNI: @_model.Dni
                        </MudChip>
                    }

                </MudStack>

                <MudDivider Class="mb-4" />

                <MudForm @ref="_form">

                    <MudGrid Spacing="2">

                        <MudItem xs="12" sm="6" md="2">
                            <MudTextField @bind-Value="_model.Dni"
                                          Label="DNI"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          MaxLength="15"
                                          Required="true"
                                          Immediate="true"
                                          Disabled="@(_editingId != 0)"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Badge" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField @bind-Value="_model.Nombres"
                                          Label="Nombres"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Person" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField @bind-Value="_model.Apellidos"
                                          Label="Apellidos"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          Immediate="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.PersonOutline" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="int?"
                                       @bind-Value="_model.TipoEmpleadoId"
                                       Label="Tipo de comensal"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                @foreach (var tipo in _tiposEmpleadoActivos)
                                {
                                    <MudSelectItem Value="@((int?)tipo.Id)">
                                        @tipo.Nombre
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?"
                                       @bind-Value="_model.EmpresaClienteId"
                                       Label="Empresa cliente"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true">
                                @foreach (var empresa in _empresasClienteActivas)
                                {
                                    <MudSelectItem Value="@((int?)empresa.Id)">
                                        @empresa.NombreComercial
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudSelect T="int?"
                                       @bind-Value="_model.SucursalId"
                                       Label="Sucursal"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true">
                                @foreach (var sucursal in SucursalesDisponibles)
                                {
                                    <MudSelectItem Value="@((int?)sucursal.Id)">
                                        @sucursal.Nombre
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="2">
                            <MudSelect T="EstadoEmpleado"
                                       @bind-Value="_model.Estado"
                                       Label="Estado"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense">
                                <MudSelectItem Value="EstadoEmpleado.Activo">Activo</MudSelectItem>
                                <MudSelectItem Value="EstadoEmpleado.Suspendido">Suspendido</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Los campos marcados con * son obligatorios.
                        </MudText>

                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Close"
                                       OnClick="Cancelar">
                                Cancelar
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="Guardar">
                                Guardar
                            </MudButton>
                        </MudStack>

                    </MudStack>

                </MudForm>

            </MudPaper>
        }

</MudStack>

</RequirePermission>

@code {
    private List<Empleado> _empleados = new();
    private List<TipoEmpleado> _tiposEmpleadoActivos = new();
    private List<EmpresaCliente> _empresasClienteActivas = new();
    private List<Sucursal> _sucursales = new();
    private Empleado _model = new();
    private MudForm? _form;

    private bool _loading = true;
    private bool _showForm;
    private int _editingId;
    private string _search = string.Empty;
    private bool _procesandoCarga;
    private EmpleadoCargaMasivaResumenDto? _resultadoCarga;
    private List<EmpleadoCargaMasivaFilaDto> _filasCargaPendiente = new();

    private IEnumerable<Empleado> FilteredEmpleados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_search))
                return _empleados;

            var term = _search.Trim().ToLower();

            return _empleados.Where(e =>
                e.Dni.ToLower().Contains(term) ||
                e.NombreCompleto.ToLower().Contains(term) ||
                e.EmpresaClienteNombre.ToLower().Contains(term) ||
                e.SucursalNombre.ToLower().Contains(term));
        }
    }

    private IEnumerable<Sucursal> SucursalesDisponibles =>
        _sucursales
            .Where(x => x.Activo)
            .Where(x => !_model.EmpresaClienteId.HasValue ||
                        !x.EmpresaClienteId.HasValue ||
                        x.EmpresaClienteId == _model.EmpresaClienteId)
            .OrderBy(x => x.Nombre);

    protected override async Task OnInitializedAsync()
    {
        await LoadTiposEmpleado();
        await LoadEmpresasSucursales();
        await LoadEmpleados();
    }

    private async Task LoadTiposEmpleado()
    {
        _tiposEmpleadoActivos = await TipoEmpleadoService.GetActivosAsync();
    }

    private async Task LoadEmpleados()
    {
        _loading = true;
        _empleados = await EmpleadoService.GetAllAsync();
        _loading = false;
    }

    private async Task LoadEmpresasSucursales()
    {
        _empresasClienteActivas = await EmpresaClienteService.GetActivasAsync();
        _sucursales = await SucursalService.GetAllAsync();
    }

    private void NuevoEmpleado()
    {
        _editingId = 0;
        _model = new Empleado
        {
            Estado = EstadoEmpleado.Activo,
            Categoria = CategoriaEmpleado.Obrero,
            TipoEmpleadoId = _tiposEmpleadoActivos.FirstOrDefault(x => x.Nombre == "Obrero")?.Id ??
                             _tiposEmpleadoActivos.FirstOrDefault()?.Id,
            EmpresaClienteId = _empresasClienteActivas.FirstOrDefault()?.Id,
            SucursalId = _sucursales.FirstOrDefault(x => x.Activo)?.Id,
            Activo = true,
            FechaCreacion = DateTime.Now
        };

        _showForm = true;
    }

    private void EditarEmpleado(Empleado empleado)
    {
        _editingId = empleado.Id;

        _model = new Empleado
        {
            Id = empleado.Id,
            Dni = empleado.Dni,
            Nombres = empleado.Nombres,
            Apellidos = empleado.Apellidos,
            Estado = empleado.Estado,
            Categoria = empleado.Categoria,
            TipoEmpleadoId = empleado.TipoEmpleadoId,
            EmpresaClienteId = empleado.EmpresaClienteId,
            SucursalId = empleado.SucursalId,
            Activo = empleado.Activo,
            FechaCreacion = empleado.FechaCreacion
        };

        _showForm = true;
    }

    private async Task Guardar()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();

            if (!_form.IsValid)
                return;
        }

        (bool Success, string Message) result;

        if (_editingId == 0)
            result = await EmpleadoService.CreateAsync(_model);
        else
            result = await EmpleadoService.UpdateAsync(_model);

        if (result.Success)
        {
            Snackbar.Add(result.Message, Severity.Success);
            _showForm = false;
            await LoadEmpleados();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Warning);
        }
    }

    private async Task CambiarActivo(int id)
    {
        var result = await EmpleadoService.ToggleActivoAsync(id);

        if (result.Success)
        {
            Snackbar.Add(result.Message, Severity.Success);
            await LoadEmpleados();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Warning);
        }
    }

    private void Cancelar()
    {
        _showForm = false;
        _model = new Empleado();
        _editingId = 0;
    }

    private async Task CambiarEstadoBeneficio(int id)
    {
        var result = await EmpleadoService.ToggleEstadoBeneficioAsync(id);

        if (result.Success)
        {
            Snackbar.Add(result.Message, Severity.Success);
            await LoadEmpleados();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Warning);
        }
    }

    private async Task PrevisualizarCargaMasiva(InputFileChangeEventArgs args)
    {
        if (!AuthState.TienePermiso(Permisos.EmpleadosCrear))
        {
            Snackbar.Add("No tiene permiso para crear comensales.", Severity.Warning);
            return;
        }

        var file = args.File;

        if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Seleccione un archivo CSV.", Severity.Warning);
            return;
        }

        try
        {
            _procesandoCarga = true;

            await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var contenido = await reader.ReadToEndAsync();
            _filasCargaPendiente = ParsearCsvEmpleados(contenido);

            _resultadoCarga = await EmpleadoService.PrevisualizarCargaMasivaAsync(_filasCargaPendiente);

            Snackbar.Add($"Carga revisada. Listos: {_resultadoCarga.Pendientes}. Observados: {_resultadoCarga.Observados}.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al revisar carga masiva: {ex.Message}", Severity.Error);
        }
        finally
        {
            _procesandoCarga = false;
        }
    }

    private async Task ConfirmarCargaMasiva()
    {
        if (_filasCargaPendiente.Count == 0)
        {
            Snackbar.Add("Primero selecciona un archivo para revisar.", Severity.Warning);
            return;
        }

        try
        {
            _procesandoCarga = true;
            _resultadoCarga = await EmpleadoService.ImportarCargaMasivaAsync(_filasCargaPendiente);

            if (_resultadoCarga.Importados > 0)
                await LoadEmpleados();

            _filasCargaPendiente = new();
            Snackbar.Add($"Carga confirmada. Importados: {_resultadoCarga.Importados}. Observados: {_resultadoCarga.Observados}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al confirmar carga masiva: {ex.Message}", Severity.Error);
        }
        finally
        {
            _procesandoCarga = false;
        }
    }

    private static List<EmpleadoCargaMasivaFilaDto> ParsearCsvEmpleados(string contenido)
    {
        var filas = new List<EmpleadoCargaMasivaFilaDto>();
        var lineas = contenido
            .Replace("\r\n", "\n")
            .Replace('\r', '\n')
            .Split('\n', StringSplitOptions.RemoveEmptyEntries);

        for (var index = 1; index < lineas.Length; index++)
        {
            var columnas = ParsearLineaCsv(lineas[index]);

            if (columnas.Count == 0 || columnas.All(string.IsNullOrWhiteSpace))
                continue;

            filas.Add(new EmpleadoCargaMasivaFilaDto
            {
                NumeroFila = index + 1,
                Dni = GetColumna(columnas, 0),
                Nombres = GetColumna(columnas, 1),
                Apellidos = GetColumna(columnas, 2),
                TipoPersonalTexto = GetColumna(columnas, 3),
                EstadoTexto = GetColumna(columnas, 4),
                ActivoTexto = GetColumna(columnas, 5)
            });
        }

        return filas;
    }

    private static List<string> ParsearLineaCsv(string linea)
    {
        var columnas = new List<string>();
        var actual = new StringBuilder();
        var enComillas = false;

        for (var i = 0; i < linea.Length; i++)
        {
            var caracter = linea[i];

            if (caracter == '"')
            {
                if (enComillas && i + 1 < linea.Length && linea[i + 1] == '"')
                {
                    actual.Append('"');
                    i++;
                }
                else
                {
                    enComillas = !enComillas;
                }

                continue;
            }

            if (caracter == ',' && !enComillas)
            {
                columnas.Add(actual.ToString().Trim());
                actual.Clear();
                continue;
            }

            actual.Append(caracter);
        }

        columnas.Add(actual.ToString().Trim());
        return columnas;
    }

    private static string GetColumna(List<string> columnas, int index)
    {
        return index < columnas.Count ? columnas[index] : string.Empty;
    }
}
