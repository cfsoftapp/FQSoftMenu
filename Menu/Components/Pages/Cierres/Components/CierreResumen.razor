@using Menu.DTOs.Cierres

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Días con movimiento</MudText>
                <MudText Typo="Typo.h5">@Resumen.DiasConMovimiento</MudText>
                <MudText Typo="Typo.caption">@Resumen.FechaDesde.ToString("dd/MM") - @Resumen.FechaHasta.ToString("dd/MM/yyyy")</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Color="Color.Info" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Menús</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalMenus</MudText>
                <MudText Typo="Typo.caption">@Resumen.TotalAlmuerzos alm. / @Resumen.TotalCenas cenas</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Success" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Proveedor</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalProveedor.ToString("C", Culture)</MudText>
                <MudText Typo="Typo.caption">Empresa + planilla</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Caja cobrada</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalCobrado.ToString("C", Culture)</MudText>
                <MudText Typo="Typo.caption">Directo y créditos pagados</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Crédito pendiente</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalCreditoPendiente.ToString("C", Culture)</MudText>
                <MudText Typo="Typo.caption">Por cobrar</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Total general</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalGeneral.ToString("C", Culture)</MudText>
                <MudText Typo="Typo.caption">@Resumen.TotalAnulados anulados</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly System.Globalization.CultureInfo Culture = new("es-PE");

    [Parameter, EditorRequired]
    public CierreResumenDto Resumen { get; set; } = new();
}
