@page "/login"

@using Menu.DTOs
@using Menu.Services

@inject UsuarioService UsuarioService
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">

    <MudPaper Class="pa-6" Elevation="3">

        <MudStack Spacing="4">

            <div class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu"
                         Color="Color.Primary"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4" Class="mt-2">
                    FQSoft Menú
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Inicia sesión para registrar consumos del comedor.
                </MudText>
            </div>

            @if (_mostrarError)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    Usuario o clave incorrectos.
                </MudAlert>
            }

            <form method="post" action="/auth/login">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_returnUrl" />

                <div class="fqsoft-login-field">
                    <label for="login-usuario">Usuario</label>
                    <div class="fqsoft-login-input-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="fqsoft-login-icon" />
                        <input id="login-usuario"
                               name="NombreUsuario"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="fqsoft-login-field mt-3">
                    <label for="login-clave">Clave</label>
                    <div class="fqsoft-login-input-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="fqsoft-login-icon" />
                        <input id="login-clave"
                               name="Clave"
                               type="password"
                               autocomplete="current-password"
                               required />
                    </div>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Login"
                           FullWidth="true"
                           Class="mt-4">
                    Ingresar
                </MudButton>
            </form>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {
    private string _returnUrl = "/";
    private bool _mostrarError;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        _mostrarError = query.ContainsKey("error");
        _returnUrl = query.TryGetValue("returnUrl", out var returnUrl) &&
                     !string.IsNullOrWhiteSpace(returnUrl)
            ? returnUrl.ToString()
            : "/";

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        AuthState.SetUsuario(authState.User);

        if (AuthState.EstaAutenticado)
        {
            Navigation.NavigateTo(_returnUrl);
        }
    }
}
