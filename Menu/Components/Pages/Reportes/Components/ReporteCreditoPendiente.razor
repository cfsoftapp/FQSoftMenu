@using Menu.DTOs.Reportes

<ReporteCardResumen Titulo="Pendiente del comensal"
                    Subtitulo="Consumos del periodo aún no cobrados."
                    Icono="@Icons.Material.Filled.PendingActions"
                    ColorIcono="Color.Error">

    <MudStack Spacing="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Menú principal</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.PendienteMenuPrincipal.ToString("C")</MudText>
        </MudStack>
        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Menú extra</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.PendienteMenuExtra.ToString("C")</MudText>
        </MudStack>
        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Producto adicional</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.PendienteProducto.ToString("C")</MudText>
        </MudStack>
    </MudStack>

    <MudDivider Class="my-3" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Total pendiente del periodo
        </MudText>

        <MudText Typo="Typo.h6" Color="Color.Error" Class="fw-bold">
            @Resumen.TotalPendienteCredito.ToString("C")
        </MudText>
    </MudStack>

</ReporteCardResumen>

@code {
    [Parameter, EditorRequired]
    public ReporteResumenDto Resumen { get; set; } = new();
}
