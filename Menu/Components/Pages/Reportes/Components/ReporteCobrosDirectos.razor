@using Menu.DTOs.Reportes

<ReporteCardResumen Titulo="Resumen de cobros directos"
                    Subtitulo="Pagos del trabajador y créditos ya cancelados."
                    Icono="@Icons.Material.Filled.Payments"
                    ColorIcono="Color.Info">

    <MudStack Spacing="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Efectivo</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.CobradoEfectivo.ToString("C")</MudText>
        </MudStack>
        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Yape</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.CobradoYape.ToString("C")</MudText>
        </MudStack>
        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Plin</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.CobradoPlin.ToString("C")</MudText>
        </MudStack>
        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Crédito pagado</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.CreditoPagado.ToString("C")</MudText>
        </MudStack>
    </MudStack>

    <MudDivider Class="my-3" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Total cobrado directo
        </MudText>

        <MudText Typo="Typo.h6" Color="Color.Info" Class="fw-bold">
            @Resumen.TotalCobradoDirecto.ToString("C")
        </MudText>
    </MudStack>

</ReporteCardResumen>

@code {
    [Parameter, EditorRequired]
    public ReporteResumenDto Resumen { get; set; } = new();
}
