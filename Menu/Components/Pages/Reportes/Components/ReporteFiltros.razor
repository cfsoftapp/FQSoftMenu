@using Menu.DTOs.Reportes

<MudPaper Class="pa-3 report-panel" Elevation="1">

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="report-filter-stack">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="report-section-title">
            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2" Class="fw-bold">Filtros</MudText>
        </MudStack>

        <MudGrid Spacing="2" Class="flex-grow-1">

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Fecha desde"
                               @bind-Date="Filtro.FechaDesde"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="Fecha hasta"
                               @bind-Date="Filtro.FechaHasta"
                               DateFormat="dd/MM/yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Disabled="Cargando"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="OnBuscar">
                    Consultar
                </MudButton>
            </MudItem>

        </MudGrid>

    </MudStack>

</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ReporteFiltroDto Filtro { get; set; } = new();

    [Parameter]
    public bool Cargando { get; set; }

    [Parameter]
    public EventCallback OnBuscar { get; set; }
}
