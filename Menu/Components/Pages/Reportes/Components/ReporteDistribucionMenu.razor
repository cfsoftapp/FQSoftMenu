@using Menu.DTOs.Reportes

<ReporteCardResumen Titulo="Distribución de menú principal"
                    Subtitulo="Clasificación según quién asume el pago."
                    Icono="@Icons.Material.Filled.RestaurantMenu"
                    ColorIcono="Color.Primary">

    <MudStack Spacing="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Empresa</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.TotalEmpresa.ToString("C")</MudText>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Planilla</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.TotalPlanilla.ToString("C")</MudText>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Pago directo</MudText>
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Resumen.TotalMenuPagoDirecto.ToString("C")</MudText>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Crédito pendiente</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Error" Class="fw-bold">@Resumen.TotalMenuCreditoPendiente.ToString("C")</MudText>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2">Crédito pagado</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Success" Class="fw-bold">@Resumen.TotalMenuCreditoPagado.ToString("C")</MudText>
        </MudStack>
    </MudStack>

    <MudDivider Class="my-3" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Total clasificado</MudText>
        <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-bold">
            @((Resumen.TotalEmpresa + Resumen.TotalPlanilla + Resumen.TotalMenuPagoDirecto + Resumen.TotalMenuCreditoPendiente + Resumen.TotalMenuCreditoPagado).ToString("C"))
        </MudText>
    </MudStack>

</ReporteCardResumen>

@code {
    [Parameter, EditorRequired]
    public ReporteResumenDto Resumen { get; set; } = new();
}
