@using Menu.DTOs.Reportes

<MudGrid Spacing="3">

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Total menús</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalMenus</MudText>
                <MudText Typo="Typo.caption">Menús principales</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Success" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Liquidación proveedor</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalProveedor.ToString("C")</MudText>
                <MudText Typo="Typo.caption">Empresa + planilla</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="2">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Warning" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">A planilla</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalPlanilla.ToString("C")</MudText>
                <MudText Typo="Typo.caption">Descuento trabajador</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Info" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Cobrado directo</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalCobradoDirecto.ToString("C")</MudText>
                <MudText Typo="Typo.caption">Efectivo, Yape, Plin y crédito pagado</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-3 rounded-lg h-100" Elevation="1">
            <MudStack Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Error" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pendiente crédito</MudText>
                <MudText Typo="Typo.h5">@Resumen.TotalPendienteCredito.ToString("C")</MudText>
                <MudText Typo="Typo.caption">Menú, extras y productos</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    [Parameter, EditorRequired]
    public ReporteResumenDto Resumen { get; set; } = new();
}