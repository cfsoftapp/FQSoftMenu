@page "/registro-diario"

@using Menu.Components.Shared
@using Menu.Enums
@using Menu.Models
@using Menu.Services
@using Menu.DTOs


@inject AuthStateService AuthState
@inject NavigationManager Navigation

@inject RegistroDiarioService RegistroDiarioService
@inject ConfiguracionMenuService ConfiguracionMenuService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<RequirePermission Permisos="new[] { Permisos.RegistroDiarioVer }">

<PageTitle>Registro diario</PageTitle>

<MudStack Spacing="3">

    <div>
        <MudText Typo="Typo.h4">Registro diario</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
                Registro de menú principal, menús extra y productos adicionales del comensal.
        </MudText>
    </div>

  
        <MudGrid Spacing="3">

            <MudItem xs="12" md="4">
                <RegistroBuscadorTrabajador Dni="@_dni"
                                            DniChanged="@(value => _dni = value)"
                                            TipoServicio="_tipoServicio"
                                            TipoServicioChanged="@(value => _tipoServicio = value)"
                                            RegistrarMenuAlEscanear="_registrarMenuAlEscanear"
                                            RegistrarMenuAlEscanearChanged="@(value => _registrarMenuAlEscanear = value)"
                                            Empleado="_empleado"
                                            OnBuscar="BuscarEmpleado"
                                            ResultadosBusqueda="_resultadosBusqueda"
                                            OnSeleccionarEmpleado="SeleccionarEmpleado"
                                            Buscando="_buscandoTrabajador"
                                            OnKeyDown="OnDniKeyDown">

                    <RegistroConsumosDelDia Consumos="_consumosDelDia"
                                            OnAnular="AnularConsumoDia" />
                    @* <RegistroConsumosDelDia Consumos="@_consumosDelDia" /> *@

                </RegistroBuscadorTrabajador>
            </MudItem>

            <MudItem xs="12" md="8">
                @if (_empleado is null)
                {
                    <RegistroComensalesRecientes Registros="_registrosRecientes"
                                                 Actualizando="_cargandoRegistrosRecientes"
                                                 OnActualizar="CargarRegistrosRecientes" />
                }
                else
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack Spacing="3">

                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.h6">Registrar adicionales</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @_empleado.NombreCompleto · @_fecha.ToString("dd/MM/yyyy")
                                </MudText>
                            </div>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="Limpiar">
                                Nuevo
                            </MudButton>
                        </MudStack>

                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Selecciona el tipo de adicional y completa los datos.
                        </MudText>

                        <MudTabs Elevation="0"
                                 Outlined="true"
                                 Rounded="true"
                                 Color="Color.Primary"
                                 ActivePanelIndex="_activeAdditionalTab"
                                 ActivePanelIndexChanged="CambiarTabAdicional">
                            <MudTabPanel Text="@($"Menú extra ({_menusExtra.Count})")"
                                         Icon="@Icons.Material.Filled.RestaurantMenu">
                                <RegistroMenusExtra Items="_menusExtra"
                                                    OnAgregar="AgregarMenuExtra"
                                                    OnQuitar="QuitarMenuExtra"
                                                    OnItemsChanged="ActualizarAdicionales" />

                                @if (_menusExtra.Any())
                                {
                                    <RegistroTotales Culture="_culture"
                                                     PagaEmpresa="CalcularPagaEmpresa(_menusExtra)"
                                                     DescuentoPlanilla="0"
                                                     CobraTrabajador="CalcularCobraComensal(_menusExtra)"
                                                     Pagado="CalcularPagado(_menusExtra)"
                                                     PendienteCredito="CalcularPendiente(_menusExtra)" />

                                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Save"
                                                   OnClick="GuardarMenusExtra"
                                                   Disabled="@(_saving || !AuthState.TienePermiso(Permisos.RegistroDiarioRegistrar))">
                                            Guardar menús extra
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudTabPanel>

                            <MudTabPanel Text="@($"Producto adicional ({_productosAdicionales.Count})")"
                                         Icon="@Icons.Material.Filled.LocalDrink">
                                <RegistroProductosAdicionales Items="_productosAdicionales"
                                                              OnAgregar="AgregarProducto"
                                                              OnQuitar="QuitarProducto"
                                                              OnItemsChanged="ActualizarAdicionales" />

                                @if (_productosAdicionales.Any())
                                {
                                    <RegistroTotales Culture="_culture"
                                                     PagaEmpresa="CalcularPagaEmpresa(_productosAdicionales)"
                                                     DescuentoPlanilla="0"
                                                     CobraTrabajador="CalcularCobraComensal(_productosAdicionales)"
                                                     Pagado="CalcularPagado(_productosAdicionales)"
                                                     PendienteCredito="CalcularPendiente(_productosAdicionales)" />

                                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Save"
                                                   OnClick="GuardarProductos"
                                                   Disabled="@(_saving || !AuthState.TienePermiso(Permisos.RegistroDiarioRegistrar))">
                                            Guardar productos
                                        </MudButton>
                                    </MudStack>
                                }
                            </MudTabPanel>
                        </MudTabs>

                        </MudStack>
                    </MudPaper>
                }
            </MudItem>

        </MudGrid>
</MudStack>

</RequirePermission>

@code {
    private readonly System.Globalization.CultureInfo _culture = new("es-PE");
    private TipoServicioMenu _tipoServicio = TipoServicioMenu.Almuerzo;
    private TipoPagoMenu _tipoPagoMenuSuspendido = TipoPagoMenu.DescuentoPlanilla;
    private FormaPago _formaPagoDirectoMenu = FormaPago.Efectivo;

    private string _dni = string.Empty;
    private DateTime _fecha = DateTime.Today;
    private Empleado? _empleado;
    private bool _registraMenu = true;
    private bool _saving;
    private bool _buscandoTrabajador;
    private bool _cargandoRegistrosRecientes;
    private bool _registrarMenuAlEscanear = true;
    private int _activeAdditionalTab;

    private decimal _precioMenu = 0m;

    private List<ConsumoAdicionalInputDto> _menusExtra = new();
    private List<ConsumoAdicionalInputDto> _productosAdicionales = new();
    private List<ConsumoDiaDto> _consumosDelDia = new();
    private List<RegistroComensalRecienteDto> _registrosRecientes = new();
    private List<Empleado> _resultadosBusqueda = new();
   
    private string TipoPagoMenuTexto
    {
        get
        {
            if (!_registraMenu || _empleado is null)
                return "No aplica";

            if (_empleado.Estado == EstadoEmpleado.Activo)
                return "Empresa cliente";

            return _tipoPagoMenuSuspendido switch
            {
                TipoPagoMenu.DescuentoPlanilla => "Descuento planilla",
                TipoPagoMenu.PagoDirecto => $"Pago directo - {_formaPagoDirectoMenu}",
                TipoPagoMenu.CreditoComedor => "Pendiente del comensal",
                _ => "No aplica"
            };
        }
    }

    private string PrecioMenuTexto => _registraMenu
        ? _precioMenu.ToString("C2", _culture)
        : "S/ 0.00";

    private IEnumerable<ConsumoAdicionalInputDto> TodosLosAdicionales =>
    _menusExtra.Concat(_productosAdicionales);

    private decimal TotalMenuTrabajador => _registraMenu ? _precioMenu : 0m;

    private bool MenuEmpresa =>
        _empleado is not null &&
        _empleado.Estado == EstadoEmpleado.Activo &&
        _registraMenu;

    private bool MenuDescuentoPlanilla =>
        _empleado is not null &&
        _empleado.Estado == EstadoEmpleado.Suspendido &&
        _registraMenu &&
        _tipoPagoMenuSuspendido == TipoPagoMenu.DescuentoPlanilla;

    private bool MenuPagoDirecto =>
        _empleado is not null &&
        _empleado.Estado == EstadoEmpleado.Suspendido &&
        _registraMenu &&
        _tipoPagoMenuSuspendido == TipoPagoMenu.PagoDirecto;

    private bool MenuCreditoComedor =>
        _empleado is not null &&
        _empleado.Estado == EstadoEmpleado.Suspendido &&
        _registraMenu &&
        _tipoPagoMenuSuspendido == TipoPagoMenu.CreditoComedor;

    private decimal TotalPagaEmpresa =>
        (MenuEmpresa ? _precioMenu : 0m)
        + TodosLosAdicionales
            .Where(x => x.FormaCobro == FormaCobroAdicional.Empresa)
            .Sum(x => x.Precio);

    private decimal TotalDescuentoPlanilla =>
        MenuDescuentoPlanilla ? _precioMenu : 0m;

    private decimal TotalAdicionales =>
        TodosLosAdicionales.Sum(x => x.Precio);

    private decimal TotalCobraTrabajador =>
        TodosLosAdicionales
            .Where(x => x.FormaCobro != FormaCobroAdicional.Empresa)
            .Sum(x => x.Precio) +
        (MenuDescuentoPlanilla || MenuPagoDirecto || MenuCreditoComedor ? _precioMenu : 0m);

    private decimal TotalPagadoMomento =>
        TodosLosAdicionales
            .Where(x => x.FormaCobro == FormaCobroAdicional.Efectivo ||
                        x.FormaCobro == FormaCobroAdicional.Yape ||
                        x.FormaCobro == FormaCobroAdicional.Plin)
            .Sum(x => x.Precio)
        + (MenuPagoDirecto ? _precioMenu : 0m);

    private decimal TotalPendienteCredito =>
        TodosLosAdicionales
            .Where(x => x.FormaCobro == FormaCobroAdicional.CreditoComedor)
            .Sum(x => x.Precio)
        + (MenuCreditoComedor ? _precioMenu : 0m);

    protected override async Task OnInitializedAsync()
    {
        await CargarPrecioMenu();
        await CargarRegistrosRecientes();
    }

    private async Task CargarPrecioMenu()
    {
        var config = await ConfiguracionMenuService.GetActualAsync();
        _precioMenu = config.PrecioMenu;
    }

    private async Task CargarRegistrosRecientes()
    {
        _cargandoRegistrosRecientes = true;

        try
        {
            _registrosRecientes = await RegistroDiarioService
                .GetRegistrosMenuRecientesAsync(_fecha);
        }
        finally
        {
            _cargandoRegistrosRecientes = false;
        }
    }

    private async Task BuscarEmpleado()
    {
        if (string.IsNullOrWhiteSpace(_dni))
        {
            Snackbar.Add("Ingrese DNI o nombre del comensal.", Severity.Warning);
            return;
        }

        _buscandoTrabajador = true;
        _resultadosBusqueda = await RegistroDiarioService.BuscarEmpleadosActivosAsync(_dni);
        _buscandoTrabajador = false;

        if (!_resultadosBusqueda.Any())
        {
            _consumosDelDia.Clear();
            Snackbar.Add("No se encontró un comensal activo con ese dato.", Severity.Warning);
            return;
        }

        var coincidenciaExacta = _resultadosBusqueda
            .FirstOrDefault(x => string.Equals(x.Dni, _dni.Trim(), StringComparison.OrdinalIgnoreCase));

        if (coincidenciaExacta is not null || _resultadosBusqueda.Count == 1)
        {
            await SeleccionarEmpleado(coincidenciaExacta ?? _resultadosBusqueda[0]);
            return;
        }

        Snackbar.Add("Selecciona el comensal en la lista de coincidencias.", Severity.Info);
    }

    private async Task SeleccionarEmpleado(Empleado empleado)
    {
        _empleado = empleado;
        _dni = empleado.Dni;
        _resultadosBusqueda.Clear();
        _registraMenu = false;

        _consumosDelDia = await RegistroDiarioService
            .GetConsumosDelDiaPorEmpleadoAsync(_empleado.Id, DateTime.Today);

        Snackbar.Add($"Comensal encontrado: {_empleado.NombreCompleto}", Severity.Success);
    }

    private async Task OnDniKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Enter")
            return;

        if (_registrarMenuAlEscanear)
            await RegistrarMenuRapido();
        else
            await BuscarEmpleado();
    }

    private async Task RegistrarMenuRapido()
    {
        if (string.IsNullOrWhiteSpace(_dni))
        {
            Snackbar.Add("Ingrese DNI para registrar menú rápido.", Severity.Warning);
            return;
        }

        if (!AuthState.EstaAutenticado || AuthState.UsuarioActual is null)
        {
            Snackbar.Add("Debe iniciar sesión para registrar consumos.", Severity.Warning);
            Navigation.NavigateTo("/login");
            return;
        }

        _buscandoTrabajador = true;
        var resultados = await RegistroDiarioService.BuscarEmpleadosActivosAsync(_dni);
        _buscandoTrabajador = false;

        var empleado = resultados
            .FirstOrDefault(x => string.Equals(x.Dni, _dni.Trim(), StringComparison.OrdinalIgnoreCase));

        if (empleado is null)
        {
            if (resultados.Count == 1)
            {
                empleado = resultados[0];
            }
            else if (resultados.Count > 1)
            {
                _resultadosBusqueda = resultados;
                Snackbar.Add("Hay varias coincidencias. Use Buscar y seleccione el comensal.", Severity.Info);
                return;
            }
        }

        if (empleado is null)
        {
            Limpiar();
            Snackbar.Add("No se encontró un comensal activo con ese DNI.", Severity.Warning);
            return;
        }

        _saving = true;

        var input = new RegistroDiarioInputDto
        {
            EmpleadoId = empleado.Id,
            Fecha = _fecha,
            TipoServicio = _tipoServicio,
            RegistraMenu = true,
            TipoPagoMenuSuspendido = empleado.Estado == EstadoEmpleado.Suspendido
                ? _tipoPagoMenuSuspendido
                : null,
            FormaPagoDirectoMenu = empleado.Estado == EstadoEmpleado.Suspendido &&
                                   _tipoPagoMenuSuspendido == TipoPagoMenu.PagoDirecto
                ? _formaPagoDirectoMenu
                : null,
            UsuarioRegistroId = AuthState.UsuarioActual.Id,
            UsuarioRegistroNombre = AuthState.UsuarioActual.NombreCompleto
        };

        var result = await RegistroDiarioService.RegistrarAsync(input);
        _saving = false;

        if (result.Success)
        {
            Snackbar.Add($"{empleado.NombreCompleto}: {result.Message}", Severity.Success);
            await CargarRegistrosRecientes();
        }
        else
            Snackbar.Add($"{empleado.NombreCompleto}: {result.Message}", Severity.Warning);

        Limpiar();
    }

    private void AgregarMenuExtra()
    {
        _menusExtra.Add(new ConsumoAdicionalInputDto
        {
            TipoAdicional = TipoAdicional.MenuExtra,
            Categoria = CategoriaConsumoAdicional.MenuCarta,
            Descripcion = "Menú extra",
            Precio = 0m,
            FormaCobro = FormaCobroAdicional.Efectivo
        });
    }

    private void AgregarProducto()
    {
        _productosAdicionales.Add(new ConsumoAdicionalInputDto
        {
            TipoAdicional = TipoAdicional.Producto,
            Categoria = CategoriaConsumoAdicional.Bebida,
            Descripcion = string.Empty,
            Precio = 0m,
            FormaCobro = FormaCobroAdicional.Efectivo
        });
    }

    private void QuitarMenuExtra(ConsumoAdicionalInputDto item)
    {
        _menusExtra.Remove(item);
    }

    private void QuitarProducto(ConsumoAdicionalInputDto item)
    {
        _productosAdicionales.Remove(item);
    }

    private void ActualizarAdicionales()
    {
        StateHasChanged();
    }

    private void CambiarTabAdicional(int nuevoIndice)
    {
        var itemsAnteriores = _activeAdditionalTab == 0
            ? _menusExtra
            : _productosAdicionales;

        var eliminados = itemsAnteriores.RemoveAll(EsBorradorVacio);
        _activeAdditionalTab = nuevoIndice;

        if (eliminados > 0)
            Snackbar.Add("Se descartó un adicional vacío al cambiar de pestaña.", Severity.Info);
    }

    private static bool EsBorradorVacio(ConsumoAdicionalInputDto item)
    {
        var descripcionVacia = string.IsNullOrWhiteSpace(item.Descripcion) ||
                               item.Descripcion == "Menú extra";

        return descripcionVacia && item.Precio <= 0;
    }

    private Task GuardarMenusExtra()
    {
        return GuardarAdicionales(_menusExtra, "menús extra");
    }

    private Task GuardarProductos()
    {
        return GuardarAdicionales(_productosAdicionales, "productos");
    }

    private async Task GuardarAdicionales(
        List<ConsumoAdicionalInputDto> items,
        string tipoRegistro)
    {
        if (_empleado is null)
        {
            Snackbar.Add("Primero busque un comensal.", Severity.Warning);
            return;
        }

        if (!items.Any())
        {
            Snackbar.Add($"Debe agregar al menos un elemento en {tipoRegistro}.", Severity.Warning);
            return;
        }

        foreach (var adicional in items)
        {
            if (string.IsNullOrWhiteSpace(adicional.Descripcion))
            {
                Snackbar.Add($"Complete la descripción de todos los {tipoRegistro}.", Severity.Warning);
                return;
            }

            if (adicional.Precio <= 0)
            {
                Snackbar.Add($"Todos los {tipoRegistro} deben tener precio mayor a cero.", Severity.Warning);
                return;
            }
        }

        _saving = true;

        if (!AuthState.EstaAutenticado || AuthState.UsuarioActual is null)
        {
            Snackbar.Add("Debe iniciar sesión para registrar consumos.", Severity.Warning);
            Navigation.NavigateTo("/login");
            return;
        }

        var input = new RegistroDiarioInputDto
        {
            EmpleadoId = _empleado.Id,
            Fecha = _fecha,
            TipoServicio = _tipoServicio,
            RegistraMenu = false,
            TipoPagoMenuSuspendido = null,
            FormaPagoDirectoMenu = null,
            Adicionales = items.ToList(),
            UsuarioRegistroId = AuthState.UsuarioActual.Id,
            UsuarioRegistroNombre = AuthState.UsuarioActual.NombreCompleto
        };

        var result = await RegistroDiarioService.RegistrarAsync(input);

        if (result.Success)
        {
            Snackbar.Add($"{tipoRegistro}: {result.Message}", Severity.Success);
            items.Clear();
            _consumosDelDia = await RegistroDiarioService
                .GetConsumosDelDiaPorEmpleadoAsync(_empleado.Id, _fecha);
            await CargarRegistrosRecientes();
        }
        else
        {
            Snackbar.Add(result.Message, Severity.Warning);
        }

        _saving = false;
    }

    private static decimal CalcularPagaEmpresa(IEnumerable<ConsumoAdicionalInputDto> items) =>
        items.Where(x => x.FormaCobro == FormaCobroAdicional.Empresa).Sum(x => x.Precio);

    private static decimal CalcularCobraComensal(IEnumerable<ConsumoAdicionalInputDto> items) =>
        items.Where(x => x.FormaCobro != FormaCobroAdicional.Empresa).Sum(x => x.Precio);

    private static decimal CalcularPagado(IEnumerable<ConsumoAdicionalInputDto> items) =>
        items.Where(x => x.FormaCobro is FormaCobroAdicional.Efectivo
                                      or FormaCobroAdicional.Yape
                                      or FormaCobroAdicional.Plin)
            .Sum(x => x.Precio);

    private static decimal CalcularPendiente(IEnumerable<ConsumoAdicionalInputDto> items) =>
        items.Where(x => x.FormaCobro == FormaCobroAdicional.CreditoComedor).Sum(x => x.Precio);

    private void Limpiar()
    {
        _dni = string.Empty;
        _empleado = null;
        _resultadosBusqueda = new List<Empleado>();
        _registraMenu = false;
        _menusExtra = new List<ConsumoAdicionalInputDto>();
        _productosAdicionales = new List<ConsumoAdicionalInputDto>();
        _consumosDelDia = new List<ConsumoDiaDto>();
        _saving = false;
    }



    private async Task AnularConsumoDia(ConsumoDiaDto item)
    {
        if (!AuthState.EstaAutenticado || AuthState.UsuarioActual is null)
        {
            Snackbar.Add("Debe iniciar sesión para anular consumos.", Severity.Warning);
            Navigation.NavigateTo("/login");
            return;
        }

        var parameters = new DialogParameters
        {
            ["Consumo"] = item
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<RegistroAnularConsumoDialog>(
            "Anular consumo",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is not RegistroAnularConsumoDialog.AnulacionConsumoDialogResult data)
        {
            Snackbar.Add("No se pudo obtener el motivo de anulación.", Severity.Warning);
            return;
        }

        var motivoTexto = ObtenerTextoMotivoAnulacion(data.Motivo);

        if (!string.IsNullOrWhiteSpace(data.Observacion))
        {
            motivoTexto = $"{motivoTexto}: {data.Observacion.Trim()}";
        }

        var response = await RegistroDiarioService.AnularConsumoDiaAsync(
            item.Origen,
            item.Id,
            AuthState.UsuarioActual.Id,
            AuthState.UsuarioActual.NombreCompleto,
            motivoTexto);

        if (response.Success)
        {
            Snackbar.Add(response.Message, Severity.Success);

            if (_empleado is not null)
            {
                _consumosDelDia = await RegistroDiarioService
                    .GetConsumosDelDiaPorEmpleadoAsync(_empleado.Id, DateTime.Today);
            }
        }
        else
        {
            Snackbar.Add(response.Message, Severity.Warning);
        }
    }

    private static string ObtenerTextoMotivoAnulacion(MotivoAnulacionConsumo motivo)
    {
        return motivo switch
        {
            MotivoAnulacionConsumo.ErrorRegistro => "Error de registro",
            MotivoAnulacionConsumo.TrabajadorEquivocado => "Comensal equivocado",
            MotivoAnulacionConsumo.TipoServicioEquivocado => "Tipo de servicio equivocado",
            MotivoAnulacionConsumo.FormaPagoEquivocada => "Forma de pago equivocada",
            MotivoAnulacionConsumo.ProductoEquivocado => "Producto equivocado",
            MotivoAnulacionConsumo.Duplicado => "Registro duplicado",
            MotivoAnulacionConsumo.NoConsumio => "El comensal no consumió",
            MotivoAnulacionConsumo.Otro => "Otro",
            _ => "Motivo no especificado"
        };
    }
}
