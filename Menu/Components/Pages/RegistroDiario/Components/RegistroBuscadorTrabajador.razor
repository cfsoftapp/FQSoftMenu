
<MudPaper Class="pa-4" Elevation="1">
    <MudStack Spacing="3">

        <MudText Typo="Typo.h6">Modo de registro</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @(RegistrarMenuAlEscanear
                ? "Enter registra inmediatamente el menú principal."
                : "Enter selecciona al comensal para registrar adicionales.")
        </MudText>

        <MudSelect T="TipoServicioMenu"
                   Value="@TipoServicio"
                   ValueChanged="TipoServicioChanged"
                   Label="Tipo de servicio"
                   Variant="Variant.Outlined">
            <MudSelectItem Value="TipoServicioMenu.Almuerzo">Almuerzo</MudSelectItem>
            <MudSelectItem Value="TipoServicioMenu.Cena">Cena</MudSelectItem>
        </MudSelect>

        <MudCheckBox T="bool"
                     Value="@RegistrarMenuAlEscanear"
                     ValueChanged="RegistrarMenuAlEscanearChanged"
                     Label="Registrar menú principal al escanear"
                     Color="Color.Primary" />

        <MudTextField Value="@Dni"
                      ValueChanged="DniChanged"
                      Label="DNI o nombre"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                      Immediate="true"
                      OnKeyDown="OnKeyDown" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="OnBuscar"
                   Disabled="@Buscando"
                   FullWidth="true">
            Buscar para adicionales
        </MudButton>

        @if (ResultadosBusqueda.Any())
        {
            <MudPaper Class="pa-2" Elevation="0" Outlined="true">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Selecciona un comensal
                    </MudText>

                    @foreach (var trabajador in ResultadosBusqueda)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   Class="justify-start"
                                   OnClick="@(() => OnSeleccionarEmpleado.InvokeAsync(trabajador))">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2" Class="fw-bold">
                                    @trabajador.NombreCompleto
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    DNI: @trabajador.Dni - @trabajador.Estado
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @trabajador.EmpresaClienteNombre / @trabajador.SucursalNombre
                                </MudText>
                            </MudStack>
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>
        }

        @if (Empleado is not null)
        {
            <MudDivider />

            <MudCard Elevation="0" Class="pa-2">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        Comensal
                    </MudText>

                    <MudText Typo="Typo.h6">
                        @Empleado.NombreCompleto
                    </MudText>

                    <MudText Typo="Typo.body2">
                        DNI: @Empleado.Dni
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Empresa cliente: @Empleado.EmpresaClienteNombre
                    </MudText>

                    <MudText Typo="Typo.body2">
                        Sucursal: @Empleado.SucursalNombre
                    </MudText>

                    <MudChip T="string"
                             Class="mt-2"
                             Size="Size.Small"
                             Color="@(Empleado.Estado == EstadoEmpleado.Activo ? Color.Success : Color.Warning)"
                             Variant="Variant.Filled">
                        @Empleado.Estado
                    </MudChip>
                </MudCardContent>
            </MudCard>
        }

        @ChildContent

    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public string Dni { get; set; } = string.Empty;

    [Parameter]
    public TipoServicioMenu TipoServicio { get; set; }

    [Parameter]
    public EventCallback<TipoServicioMenu> TipoServicioChanged { get; set; }

    [Parameter]
    public bool RegistrarMenuAlEscanear { get; set; }

    [Parameter]
    public EventCallback<bool> RegistrarMenuAlEscanearChanged { get; set; }

    [Parameter]
    public EventCallback<string> DniChanged { get; set; }

    [Parameter]
    public Empleado? Empleado { get; set; }

    [Parameter]
    public EventCallback OnBuscar { get; set; }

    [Parameter]
    public IReadOnlyList<Empleado> ResultadosBusqueda { get; set; } = Array.Empty<Empleado>();

    [Parameter]
    public EventCallback<Empleado> OnSeleccionarEmpleado { get; set; }

    [Parameter]
    public bool Buscando { get; set; }

    [Parameter]
    public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
